# Work directory for jobs, clips, and zips (default: ./var)
ALPHACLIP_WORK=./var

# Optional caption font (.ttf / .otf)
# ALPHACLIP_FONT=/usr/share/fonts/truetype/macos/Inter-Bold.ttf

# Whisper model when not using --mock-transcript (tiny|base|small|medium|large-v3)
ALPHACLIP_WHISPER_MODEL=tiny

# Optional binary overrides
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# YTDLP_BIN=yt-dlp
# WHISPER_BIN=whisper

# --- Schedule hooks (optional; dry-run without these) ---
# Buffer: https://buffer.com/developers
# BUFFER_ACCESS_TOKEN=
# BUFFER_PROFILE_ID=

# Late: https://getlate.dev
# LATE_API_KEY=
# LATE_ACCOUNT_ID=
